{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Presentation Verification Report",
  "type": "object",
  "required": ["artifact", "outputRoute", "checks", "issues", "limitations", "finalStatus"],
  "properties": {
    "artifact": { "type": "string" },
    "outputRoute": { "type": "string" },
    "filesProduced": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sourceMaterials": {
      "type": "array",
      "items": { "type": "string" }
    },
    "renderArtifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "buildProvenance": {
      "type": "object",
      "properties": {
        "deckPlan": { "type": "string" },
        "builder": { "type": "string" },
        "singleWriter": { "type": "boolean" },
        "appendModeUsed": { "type": "boolean" },
        "finalPassCompleted": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "editProvenance": {
      "type": "object",
      "properties": {
        "editMode": {
          "type": "string",
          "enum": ["none", "source-first-edit", "preserve-edit", "regenerate", "template-edit", "repair"]
        },
        "sourceSpecUpdated": { "type": "boolean" },
        "cleanRegeneration": { "type": "boolean" },
        "preserveEditScoped": { "type": "boolean" },
        "evidence": { "type": "string" }
      },
      "additionalProperties": false
    },
    "orderCheck": {
      "type": "object",
      "properties": {
        "expectedSlides": { "type": "integer" },
        "actualSlides": { "type": "integer" },
        "closingSlideLast": { "type": "boolean" },
        "matchesDeckPlan": { "type": "boolean" },
        "evidence": { "type": "string" }
      },
      "additionalProperties": false
    },
    "pageNumberCheck": {
      "type": "object",
      "properties": {
        "checked": { "type": "boolean" },
        "mismatches": { "type": "integer" },
        "evidence": { "type": "string" }
      },
      "additionalProperties": false
    },
    "packageDiffCheck": {
      "type": "object",
      "properties": {
        "checked": { "type": "boolean" },
        "passed": { "type": "boolean" },
        "allowlist": {
          "type": "array",
          "items": { "type": "string" }
        },
        "unexpectedChanges": { "type": "integer" },
        "evidence": { "type": "string" }
      },
      "additionalProperties": false
    },
    "deliveryGate": {
      "type": "object",
      "properties": {
        "checked": { "type": "boolean" },
        "passed": { "type": "boolean" },
        "blockingWarnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reviewWarnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence": { "type": "string" }
      },
      "additionalProperties": false
    },
    "layoutCheck": {
      "type": "object",
      "properties": {
        "checked": { "type": "boolean" },
        "outOfBoundsObjects": { "type": "integer" },
        "overlapWarnings": { "type": "integer" },
        "shapeOverflows": { "type": "integer" },
        "pictureOverflows": { "type": "integer" },
        "tableOverflows": { "type": "integer" },
        "crowdedTables": { "type": "integer" },
        "tinyTextWarnings": { "type": "integer" },
        "timelineWarnings": { "type": "integer" },
        "sparseStubSlides": { "type": "integer" },
        "closingSlideNotLast": { "type": "integer" },
        "textPictureOverlaps": { "type": "integer" },
        "sectionPictureCollisions": { "type": "integer" },
        "blankShapeOverPictures": { "type": "integer" },
        "fullSlidePictureOverText": { "type": "integer" },
        "imageAspectDistortions": { "type": "integer" },
        "severeImageResolutionWarnings": { "type": "integer" },
        "imageResolutionWarnings": { "type": "integer" },
        "imageCropWarnings": { "type": "integer" },
        "missingImageDimensions": { "type": "integer" },
        "recipeViolations": { "type": "integer" },
        "evidence": { "type": "string" }
      },
      "additionalProperties": false
    },
    "assetCheck": {
      "type": "object",
      "properties": {
        "checked": { "type": "boolean" },
        "missingAssets": { "type": "integer" },
        "genericOrIrrelevantAssets": { "type": "integer" },
        "layeringWarnings": { "type": "integer" },
        "aspectWarnings": { "type": "integer" },
        "resolutionWarnings": { "type": "integer" },
        "cropWarnings": { "type": "integer" },
        "dimensionWarnings": { "type": "integer" },
        "evidence": { "type": "string" }
      },
      "additionalProperties": false
    },
    "renderCheck": {
      "type": "object",
      "properties": {
        "checked": { "type": "boolean" },
        "slidesRendered": { "type": "integer" },
        "visualDefects": { "type": "integer" },
        "evidence": { "type": "string" }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["passed", "warning", "failed", "skipped"] },
          "tool": { "type": "string" },
          "evidence": { "type": "string" },
          "result": {}
        },
        "additionalProperties": false
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "description"],
        "properties": {
          "severity": { "type": "string", "enum": ["info", "warning", "error"] },
          "description": { "type": "string" },
          "fixed": { "type": "boolean" },
          "status": { "type": "string", "enum": ["open", "fixed", "accepted"] }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "finalStatus": { "type": "string", "enum": ["passed", "warning", "failed"] }
  },
  "additionalProperties": false
}
