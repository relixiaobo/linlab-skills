{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deck Plan",
  "type": "object",
  "required": ["title", "audience", "goal", "outputRoute", "buildMode", "slides"],
  "properties": {
    "title": { "type": "string" },
    "audience": { "type": "string" },
    "goal": { "type": "string" },
    "outputRoute": { "type": "string" },
    "buildMode": {
      "type": "string",
      "enum": ["single-pass", "template-edit", "html-deck", "pdf-handout", "speaker-outline", "cover-image", "repair"]
    },
    "deliveryMode": {
      "type": "string",
      "description": "live-talk, reading-share, agent-maintained-source, visual-showcase, handout, or another explicit mode"
    },
    "editabilityRequirement": {
      "type": "string",
      "description": "human-native-editable, visual-only, mixed, or not-required"
    },
    "revisionSurface": {
      "type": "string",
      "description": "source-first, native-pptx, visual-only, or mixed"
    },
    "layoutMode": {
      "type": "string",
      "enum": ["compiler", "template-preserve", "manual-repair"],
      "description": "compiler for generated layouts, template-preserve for native template fills, manual-repair for existing broken decks"
    },
    "notesMode": {
      "type": "string",
      "description": "none, brief-speaker-notes, verbatim-script, presenter-mode, or outline-only"
    },
    "visualTemperament": { "type": "string" },
    "visualSystem": {
      "type": "object",
      "properties": {
        "direction": { "type": "string" },
        "stylePack": { "type": "string" },
        "theme": { "type": "string" },
        "motif": { "type": "string" },
        "typography": { "type": "string" },
        "layoutRules": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "sourceMaterials": {
      "type": "array",
      "items": { "type": "string" }
    },
    "assetInventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset", "role"],
        "properties": {
          "asset": { "type": "string" },
          "role": { "type": "string" },
          "source": { "type": "string" },
          "path": { "type": "string" },
          "status": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "storySpine": {
      "type": "array",
      "items": { "type": "string" }
    },
    "globalElements": {
      "type": "object",
      "properties": {
        "pageNumbers": { "type": "boolean" },
        "totalSlideCount": { "type": "boolean" },
        "tableOfContents": { "type": "boolean" },
        "sectionCounters": { "type": "boolean" },
        "closingSlideId": { "type": "string" },
        "finalPassRequired": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "slide", "purpose", "headline", "layout", "density", "visual"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "slide": { "type": ["integer", "string"] },
          "type": { "type": "string" },
          "section": { "type": "string" },
          "purpose": { "type": "string" },
          "headline": { "type": "string" },
          "evidence": { "type": "string" },
          "layout": {
            "type": "string",
            "enum": [
              "cover",
              "hero-media",
              "product-stage",
              "section",
              "split",
              "metric",
              "compare",
              "timeline",
              "diagram",
              "chart",
              "map-callout",
              "feature-grid",
              "gallery",
              "statement",
              "quote",
              "table-takeaway",
              "close",
              "scripted-demo",
              "evidence-wall"
            ]
          },
          "density": {
            "type": "string",
            "enum": ["sparse", "medium", "dense"]
          },
          "layoutIntent": {
            "type": "string",
            "description": "The composition decision the layout compiler should satisfy"
          },
          "visual": { "type": "string" },
          "visualSpec": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "none",
                  "background",
                  "hero",
                  "right-evidence",
                  "left-evidence",
                  "map",
                  "chart",
                  "logo",
                  "thumbnail",
                  "callout",
                  "decorative-accepted"
                ]
              },
              "asset": { "type": "string" },
              "fit": {
                "type": "string",
                "enum": ["contain", "cover", "stretch", "original"]
              },
              "slot": { "type": "string" },
              "layer": {
                "type": "string",
                "enum": ["background", "image", "overlay", "text", "logo", "folio"]
              },
              "notes": { "type": "string" }
            },
            "additionalProperties": false
          },
          "layers": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["background", "frame", "image", "overlay", "text", "logo", "folio"]
            }
          },
          "geometryNotes": {
            "type": "string",
            "description": "Optional constraints for the layout compiler"
          },
          "assetPlan": { "type": "string" },
          "assets": {
            "type": "array",
            "items": { "type": "string" }
          },
          "sourceRefs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "verificationPlan": {
      "type": "array",
      "items": { "type": "string" }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
