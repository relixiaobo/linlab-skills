{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Presentation Evidence Ledger",
  "description": "Structured sources, claims, metric definitions, and assets used by a source-heavy presentation.",
  "type": "object",
  "required": ["schemaVersion", "cutoffDate", "sources", "claims", "assets"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "cutoffDate": { "type": "string", "format": "date" },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    },
    "definitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/definition" }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "source": {
      "type": "object",
      "required": ["id", "title", "publisher", "type", "status", "accessedAt", "authority"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["official", "regulatory", "company", "academic", "user-provided", "industry", "media", "other"]
        },
        "status": { "type": "string", "enum": ["core", "candidate", "rejected"] },
        "cutoffUse": { "type": "string", "enum": ["within-cutoff", "retrospective"] },
        "publishedAt": { "type": "string", "format": "date" },
        "accessedAt": { "type": "string", "format": "date" },
        "url": { "type": "string", "format": "uri" },
        "localRef": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 },
        "rights": { "type": "string" },
        "notes": { "type": "string" }
      },
      "anyOf": [
        { "required": ["url"] },
        { "required": ["localRef"] }
      ],
      "additionalProperties": false
    },
    "claimValue": {
      "type": "object",
      "required": ["display"],
      "properties": {
        "display": { "type": "string", "minLength": 1 },
        "number": { "type": "number" },
        "unit": { "type": "string" },
        "scope": { "type": "string" }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["id", "statement", "kind", "status", "sourceRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["fact", "plan", "estimate", "interpretation", "definition"] },
        "status": { "type": "string", "enum": ["verified", "provisional", "disputed", "rejected"] },
        "relevantAt": { "type": "string", "format": "date" },
        "value": { "$ref": "#/$defs/claimValue" },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "definitionRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "conflictsWith": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "caveats": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "usedBy": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "definition": {
      "type": "object",
      "required": ["id", "label", "definition"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "definition": { "type": "string", "minLength": 1 },
        "unit": { "type": "string" },
        "scope": { "type": "string" }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": ["id", "type", "sourceRef", "localFile", "factualRole", "rights"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "enum": ["image", "chart", "map", "document", "logo", "video", "other"] },
        "sourceRef": { "$ref": "#/$defs/id" },
        "localFile": { "type": "string", "minLength": 1 },
        "factualRole": { "type": "string", "minLength": 1 },
        "rights": { "type": "string", "minLength": 1 },
        "transformations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
