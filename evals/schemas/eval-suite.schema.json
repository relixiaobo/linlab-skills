{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linlab.dev/schemas/eval-suite.schema.json",
  "title": "Skill evaluation suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "runs", "defaults", "comparison"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"$ref": "#/$defs/slug"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/run"}
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repetitions", "timeout_seconds"],
      "properties": {
        "repetitions": {"type": "integer", "minimum": 1, "maximum": 100},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_condition", "metrics"],
      "properties": {
        "control_condition": {"type": "string", "minLength": 1},
        "metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["score", "input_tokens", "output_tokens", "total_tokens", "duration_ms"]
          }
        }
      }
    },
    "metadata": {"type": "object"}
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case", "conditions"],
      "properties": {
        "case": {"type": "string", "minLength": 1},
        "conditions": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "repetitions": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    }
  }
}
