{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linlab.dev/schemas/eval-judge-registry.schema.json",
  "title": "Skill evaluation Judge Adapter registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapters"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/adapter"}
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "protocol_version",
        "command",
        "jobs"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "kind": {
          "type": "string",
          "enum": ["deterministic", "model", "hybrid"]
        },
        "protocol_version": {"const": "1.0"},
        "command": {"type": "string", "minLength": 1},
        "jobs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/slug"}
        },
        "description": {"type": "string"},
        "config": {"type": "object"}
      }
    }
  }
}
