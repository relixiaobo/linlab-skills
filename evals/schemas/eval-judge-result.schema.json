{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linlab.dev/schemas/eval-judge-result.schema.json",
  "title": "Raw Judge Adapter result protocol",
  "type": "object",
  "additionalProperties": false,
  "required": ["scores", "failure_tags", "summary"],
  "properties": {
    "scores": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/score"}
    },
    "failure_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "summary": {"type": "string"}
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "value", "rationale", "evidence"],
      "properties": {
        "criterion_id": {"$ref": "#/$defs/slug"},
        "value": {"type": "number", "minimum": 0, "maximum": 1},
        "passed": {"type": "boolean"},
        "rationale": {"type": "string"},
        "evidence": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  }
}
