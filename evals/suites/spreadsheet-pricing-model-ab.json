{
  "schema_version": "1.0",
  "id": "spreadsheet-pricing-model-ab",
  "title": "Spreadsheet pricing-model paired evaluation",
  "description": "Natural-routing baseline and current Spreadsheet Skill comparison on a formula-driven XLSX pricing model.",
  "runs": [
    {
      "case": "evals/cases/build-pricing-model-workbook",
      "conditions": [
        "evals/conditions/baseline.json",
        "evals/conditions/spreadsheet-enabled.json"
      ]
    }
  ],
  "defaults": {
    "repetitions": 1,
    "timeout_seconds": 1800
  },
  "judging": {
    "required": true
  },
  "comparison": {
    "control_condition": "baseline",
    "metrics": [
      "score",
      "task_score",
      "input_tokens",
      "output_tokens",
      "total_tokens",
      "duration_ms",
      "judge_duration_ms"
    ]
  },
  "metadata": {
    "case_organization": "user-job",
    "oracle_visibility": "judge-only",
    "migration_status": "migrated from legacy spreadsheet-pricing-model"
  }
}
