{
  "schema_version": "1.0",
  "id": "presentation-precision-edit-ab",
  "title": "Presentation precision-edit ablation evaluation",
  "description": "Repeated baseline, current Skill, and precision-guidance ablation comparison on one exact package-preserving PPTX edit.",
  "runs": [
    {
      "case": "evals/cases/edit-board-deck-subtitle",
      "conditions": [
        "evals/conditions/baseline.json",
        "evals/conditions/presentation-enabled.json",
        "evals/conditions/presentation-no-precision-edit-guidance.json"
      ]
    }
  ],
  "defaults": {
    "repetitions": 3,
    "timeout_seconds": 1800
  },
  "judging": {
    "required": true
  },
  "comparison": {
    "control_condition": "baseline",
    "metrics": [
      "score",
      "task_score",
      "input_tokens",
      "output_tokens",
      "total_tokens",
      "duration_ms",
      "judge_duration_ms"
    ]
  },
  "metadata": {
    "case_organization": "user-job",
    "oracle_visibility": "judge-only",
    "experiment": "presentation-precision-editing",
    "intervention_behavior": "presentation-precision-editing",
    "legacy_case": "presentation-surgeon-single-target"
  }
}
