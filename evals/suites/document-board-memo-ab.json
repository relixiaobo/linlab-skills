{
  "schema_version": "1.0",
  "id": "document-board-memo-ab",
  "title": "Document board-memo paired evaluation",
  "description": "Natural-routing baseline and current Document Skill comparison on a source-grounded board decision memo.",
  "runs": [
    {
      "case": "evals/cases/create-enterprise-pilot-board-memo",
      "conditions": [
        "evals/conditions/baseline.json",
        "evals/conditions/document-enabled.json"
      ]
    }
  ],
  "defaults": {
    "repetitions": 1,
    "timeout_seconds": 1800
  },
  "judging": {
    "required": true
  },
  "comparison": {
    "control_condition": "baseline",
    "metrics": [
      "score",
      "task_score",
      "input_tokens",
      "output_tokens",
      "total_tokens",
      "duration_ms",
      "judge_duration_ms"
    ]
  },
  "metadata": {
    "case_organization": "user-job",
    "oracle_visibility": "judge-only",
    "migration_status": "migrated from legacy document-board-memo"
  }
}
