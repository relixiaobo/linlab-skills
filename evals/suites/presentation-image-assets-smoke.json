{
  "schema_version": "1.0",
  "id": "presentation-image-assets-smoke",
  "title": "Presentation controlled image-asset vertical smoke",
  "description": "One fresh run per condition on a product deck with required and forbidden image assets.",
  "runs": [
    {
      "case": "evals/cases/create-incident-response-launch",
      "conditions": [
        "evals/conditions/baseline.json",
        "evals/conditions/presentation-main.json",
        "evals/conditions/presentation-image-improved.json",
        "evals/conditions/presentation-image-improved-no-visual-instructions.json"
      ],
      "repetitions": 1
    }
  ],
  "defaults": {
    "repetitions": 1,
    "timeout_seconds": 2100
  },
  "judging": {
    "required": true
  },
  "comparison": {
    "control_condition": "baseline",
    "metrics": ["score", "input_tokens", "output_tokens", "total_tokens", "duration_ms"]
  },
  "metadata": {
    "case_organization": "user-job",
    "oracle_visibility": "judge-only",
    "experiment": "presentation-controlled-image-assets-0fdd27c"
  }
}
