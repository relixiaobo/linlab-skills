{
  "schema_version": "1.0",
  "id": "presentation-current-image-assets-ab",
  "title": "Current Presentation image-asset ablation evaluation",
  "description": "Repeated baseline, current Skill, and asset-guidance ablation comparison on a case with approved and decoy image assets.",
  "runs": [
    {
      "case": "evals/cases/create-incident-response-launch",
      "conditions": [
        "evals/conditions/baseline.json",
        "evals/conditions/presentation-enabled.json",
        "evals/conditions/presentation-no-visual-guidance.json"
      ]
    }
  ],
  "defaults": {
    "repetitions": 3,
    "timeout_seconds": 2100
  },
  "judging": {
    "required": true
  },
  "comparison": {
    "control_condition": "baseline",
    "metrics": [
      "score",
      "task_score",
      "input_tokens",
      "output_tokens",
      "total_tokens",
      "duration_ms",
      "judge_duration_ms"
    ]
  },
  "metadata": {
    "case_organization": "user-job",
    "oracle_visibility": "judge-only",
    "experiment": "presentation-current-asset-handling",
    "intervention_behavior": "presentation-asset-handling"
  }
}
