{
  "schema_version": "1.0",
  "id": "representative-ab",
  "title": "Representative paired Skill evaluation",
  "description": "Natural-routing and capability comparisons across three different user jobs.",
  "runs": [
    {
      "case": "evals/cases/create-investor-update",
      "conditions": [
        "evals/conditions/baseline.json",
        "evals/conditions/presentation-enabled.json",
        "evals/conditions/presentation-no-visual-guidance.json"
      ]
    },
    {
      "case": "evals/cases/analyze-order-revenue",
      "conditions": [
        "evals/conditions/baseline.json",
        "evals/conditions/data-analysis-enabled.json"
      ]
    },
    {
      "case": "evals/cases/shape-merchant-addon-controls",
      "conditions": [
        "evals/conditions/baseline.json",
        "evals/conditions/shape-product-spec-enabled.json"
      ]
    }
  ],
  "defaults": {
    "repetitions": 3,
    "timeout_seconds": 1800
  },
  "judging": {
    "required": true
  },
  "comparison": {
    "control_condition": "baseline",
    "metrics": ["score", "task_score", "input_tokens", "output_tokens", "total_tokens", "duration_ms"]
  },
  "metadata": {
    "case_organization": "user-job",
    "oracle_visibility": "judge-only",
    "migration_status": "all representative jobs have production Judge Adapters"
  }
}
