{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document Plan",
  "type": "object",
  "required": ["title", "audience", "goal", "outputRoute", "sections"],
  "properties": {
    "title": { "type": "string" },
    "audience": { "type": "string" },
    "goal": { "type": "string" },
    "outputRoute": { "type": "string" },
    "revisionSurface": {
      "type": "string",
      "description": "source-first, native-docx, generated-docx, visual-only, or mixed"
    },
    "reviewMode": {
      "type": "string",
      "description": "none, comments, tracked-changes, redline, clean-copy, reader-test, or mixed"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "author": { "type": "string" },
        "date": { "type": "string" },
        "version": { "type": "string" },
        "status": { "type": "string" },
        "classification": { "type": "string" },
        "template": { "type": "string" },
        "documentType": { "type": "string" }
      },
      "additionalProperties": false
    },
    "archetype": { "type": "string" },
    "designPreset": { "type": "string" },
    "tone": { "type": "string" },
    "sourceMaterials": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sourceMap": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "supports"],
        "properties": {
          "source": { "type": "string" },
          "supports": { "type": "string" },
          "section": { "type": "string" },
          "claim": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["heading", "purpose"],
        "properties": {
          "heading": { "type": "string" },
          "purpose": { "type": "string" },
          "formFactor": { "type": "string" },
          "source": { "type": "string" },
          "sourceId": { "type": "string" },
          "reviewState": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "verificationPlan": {
      "type": "array",
      "items": { "type": "string" }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
